#!/usr/bin/env bash
# xr-head-aim toggle|on|off|recenter|state|tune k=v...|tune reset
# The service runs all session; on/off is a setting, so it sticks across restarts.
set -uo pipefail
here=$(cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd)
case "${1:-toggle}" in
  pause) exec python3 "$here/xr_head_aim.py" toggle ;;   # old name for toggle
  recenter) systemctl --user kill --kill-whom=main --signal=SIGUSR1 xr-head-aim.service ;;
  toggle|on|off|state|tune) exec python3 "$here/xr_head_aim.py" "$@" ;;
  *) sed -n 2p "$0" >&2; exit 2 ;;
esac
